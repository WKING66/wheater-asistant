# DeepSeek 官方 API：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 每日邮件推送的 SMTP 配置（用你自己的邮箱发信给收件人）
# 注意：这里的密码是「SMTP 授权码」，不是邮箱登录密码，需去邮箱设置里单独开启获取。
#
#   QQ 邮箱   ：SMTP_HOST=smtp.qq.com      SMTP_PORT=465
#   163 邮箱  ：SMTP_HOST=smtp.163.com     SMTP_PORT=465
#   Gmail    ：SMTP_HOST=smtp.gmail.com   SMTP_PORT=465
#   Outlook  ：SMTP_HOST=smtp.office365.com SMTP_PORT=587
#
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=你的SMTP授权码
